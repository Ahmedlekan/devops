# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure("2") do |config|
  # Use a more reliable base box
  config.vm.box = "bento/ubuntu-22.04"
  config.vm.box_check_update = false
  
  # Increase boot timeout
  config.vm.boot_timeout = 600
  
  # Network configuration
  config.vm.network "private_network", ip: "192.168.56.16", auto_config: true
  
  # Provider-specific configuration
  config.vm.provider "virtualbox" do |vb|
    vb.name = "vprofile-vm"
    vb.gui = false  # Disable GUI for better performance
    vb.memory = 4096  # Increased memory
    vb.cpus = 2
    
    # Enable hardware virtualization
    vb.customize ["modifyvm", :id, "--ioapic", "on"]
    vb.customize ["modifyvm", :id, "--natdnshostresolver1", "on"]
    vb.customize ["modifyvm", :id, "--nictype1", "virtio"]
    vb.customize ["modifyvm", :id, "--nictype2", "virtio"]
  end
  
  # Provisioning - install essential packages
  config.vm.provision "shell", inline: <<-SHELL
    # Update system
    apt-get update -y
    apt-get upgrade -y
    
    # Install Docker prerequisites
    apt-get install -y \
      apt-transport-https \
      ca-certificates \
      curl \
      gnupg \
      lsb-release
    
    # Add Docker repository
    curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /usr/share/keyrings/docker-archive-keyring.gpg
    echo \
      "deb [arch=amd64 signed-by=/usr/share/keyrings/docker-archive-keyring.gpg] https://download.docker.com/linux/ubuntu \
      $(lsb_release -cs) stable" | tee /etc/apt/sources.list.d/docker.list > /dev/null
    
    # Install Docker
    apt-get update -y
    apt-get install -y docker-ce docker-ce-cli containerd.io
    
    # Add vagrant user to docker group
    usermod -aG docker vagrant
    
    # Verify Docker installation
    docker --version
  SHELL
end
